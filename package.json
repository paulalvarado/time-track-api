{
  "name": "time-track-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate:make": "tsx src/commands/MigrateMake.ts",
    "migrate:status": "tsx src/commands/MigrateStatus.ts",
    "migrate:up": "tsx src/commands/MigrateRun.ts",
    "migrate:down": "tsx src/commands/MigrateRollback.ts --down",
    "migrate:refresh": "tsx src/commands/MigrateRefresh.ts",
    "migrate:rollback": "tsx src/commands/MigrateRollback.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@prisma/client": "^6.0.0",
    "better-auth": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.0.0",
    "xmlrpc": "^1.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/xmlrpc": "^1.3.0",
    "console-table-printer": "^2.0.0",
    "kolorist": "^1.8.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
