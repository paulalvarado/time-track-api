{
  "name": "time-track-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx nodemon --legacy-watch -e ts --exec \"tsx src/index.ts\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:migrate": "tsx src/commands/migraterun.ts && node dist/index.js",
    "start:prod": "tsx src/commands/migraterun.ts && node dist/index.js",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "migrate:make": "tsx src/commands/migratemake.ts",
    "migrate:status": "tsx src/commands/migratestatus.ts",
    "migrate:up": "tsx src/commands/migraterun.ts",
    "migrate:down": "tsx src/commands/migraterollback.ts --down",
    "migrate:refresh": "tsx src/commands/migraterefresh.ts",
    "migrate:rollback": "tsx src/commands/migraterollback.ts",
    "odoo:sync": "npx tsx src/commands/syncworker.ts"
  },
  "dependencies": {
    "@fastify/cors": "10.1.0",
    "@fastify/jwt": "9.1.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.6.23",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.9.0",
    "pg": "8.22.0",
    "tsx": "4.23.0",
    "xmlrpc": "1.3.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "22.20.0",
    "@types/pg": "8.20.0",
    "@types/xmlrpc": "1.3.10",
    "console-table-printer": "2.16.1",
    "kolorist": "1.8.0",
    "nodemon": "^3.1.14",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
