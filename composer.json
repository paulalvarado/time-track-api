{
    "name": "timetrack/api",
    "description": "Time Track API - CodeIgniter 4",
    "type": "project",
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.6",
        "firebase/php-jwt": "^6.10",
        "phpxmlrpc/phpxmlrpc": "^4.10",
        "phpoffice/phpspreadsheet": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "codeigniter4/akismet": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-install-cmd": [
            "CodeIgniter\\CodeIgniter::postInstall"
        ]
    }
}
