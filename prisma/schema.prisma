generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  password     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  odooConfig   OdooConfig?
  projects     Project[]

  @@map("User")
}

model OdooConfig {
  id          String        @id @default(cuid())
  userId      String        @unique
  url         String
  dbName      String
  username    String
  apiKey      String
  geminiApiKey String?
  user        User          @relation(fields: [userId], references: [id])
  syncState   SyncState?
  syncProjects SyncProject[]
  syncStages  SyncStage[]
  syncTasks   SyncTask[]
  syncTimesheets SyncTimesheet[]
  syncProjectStages SyncProjectStage[]
  catalogs          Catalog[]

  @@map("OdooConfig")
}

model Project {
  id          String   @id @default(cuid())
  odooId      Int
  name        String
  userId      String
  odooUserId  Int?
  color       Int?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@unique([odooId, userId])
  @@map("Project")
}

model SyncProject {
  id           String      @id @default(cuid())
  odooId       Int
  name         String
  color        Int?
  odooUserId   Int?
  odooConfigId String
  odooConfig   OdooConfig  @relation(fields: [odooConfigId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([odooId, odooConfigId])
  @@map("syncproject")
}

model SyncState {
  id           String    @id @default(cuid())
  odooConfigId String    @unique
  lastSyncAt   DateTime?
  syncing      Boolean   @default(false)
  error        String?
  odooUid      Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  odooConfig   OdooConfig @relation(fields: [odooConfigId], references: [id])

  @@map("syncstate")
}

model SyncStage {
  id           String      @id @default(cuid())
  odooId       Int
  name         String
  sequence     Int
  odooConfigId String
  odooConfig   OdooConfig  @relation(fields: [odooConfigId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tasks        SyncTask[]
  stageProjects SyncProjectStage[]

  @@unique([odooId, odooConfigId])
  @@map("syncstage")
}

model SyncProjectStage {
  id           String      @id @default(cuid())
  stageOdooId  Int
  projectOdooId Int
  odooConfigId String
  odooConfig   OdooConfig  @relation(fields: [odooConfigId], references: [id])
  stage        SyncStage   @relation(fields: [stageOdooId, odooConfigId], references: [odooId, odooConfigId])
  createdAt    DateTime    @default(now())

  @@unique([stageOdooId, projectOdooId, odooConfigId])
  @@index([projectOdooId, odooConfigId])
  @@map("syncprojectstage")
}

model SyncTask {
  id            String      @id @default(cuid())
  odooId        Int
  name          String
  description   String?
  stageOdooId   Int?
  assigneeIds   Json?
  priority      String?
  deadline      String?
  color         Int?
  projectOdooId Int
  odooConfigId  String
  odooConfig    OdooConfig  @relation(fields: [odooConfigId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  stage         SyncStage?  @relation(fields: [stageOdooId, odooConfigId], references: [odooId, odooConfigId])
  timesheets    SyncTimesheet[]

  @@unique([odooId, odooConfigId])
  @@index([projectOdooId, odooConfigId])
}

model Catalog {
  id           String        @id @default(cuid())
  name         String
  odooConfigId String
  odooConfig   OdooConfig    @relation(fields: [odooConfigId], references: [id])
  lastSyncAt   DateTime?
  items        CatalogItem[]
  createdAt    DateTime      @default(now())

  @@unique([name, odooConfigId])
  @@map("Catalog")
}

model CatalogItem {
  id        String   @id @default(cuid())
  catalogId String
  catalog   Catalog  @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  key       String
  value     String
  extra     Json?
  createdAt DateTime @default(now())

  @@unique([catalogId, key])
  @@map("CatalogItem")
}

model SyncTimesheet {
  id           String      @id @default(cuid())
  odooId       Int
  name         String?
  unitAmount   Float
  date         String?
  userOdooId   Int?
  taskOdooId   Int
  odooConfigId String

  @@map("synctimesheet")
  odooConfig   OdooConfig  @relation(fields: [odooConfigId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  task         SyncTask    @relation(fields: [taskOdooId, odooConfigId], references: [odooId, odooConfigId])

  @@unique([odooId, odooConfigId])
  @@index([taskOdooId, odooConfigId])
}
